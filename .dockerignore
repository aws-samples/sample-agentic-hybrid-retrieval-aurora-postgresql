!docs/
!docs/build-retrieval-tool.md
!docs/use-in-your-app.md
!examples/
!examples/call_headphones.py
!deploy/
!deploy/agentcore/
!deploy/agentcore/app.py
**/__pycache__
**/.env
**/.env.*
