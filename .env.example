# Local Postgres connection string. Set this in your local .env file.
DATABASE_URL=postgresql://localhost:55432/retrieval?sslmode=disable

AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
APP_DISPLAY_NAME=Threadline
PGVECTOR_VERSION=v0.8.2
PGVECTOR_MIN_VERSION=0.8.1
POSTGRES_MIN_VERSION=18.3
POSTGRES_HOME=/usr/local/opt/postgresql@18

# Embeddings: hash is deterministic, local, and workshop-safe (matches the local
# `make local-db-bootstrap` corpus, which is also hash-embedded). The provider MUST
# match the loaded data's embedding space: if you restore the shipped seed dump
# (real Cohere embed-v4 vectors), set EMBED_PROVIDER=bedrock so live /v1/search
# queries embed with the same model. The canonical Orion answer is served from a
# stored row and renders identically under either provider.
EMBED_PROVIDER=hash
EMBED_DIM=1024
BEDROCK_OPUS_MODEL=global.anthropic.claude-opus-4-8
BEDROCK_SONNET_MODEL=global.anthropic.claude-sonnet-5
BEDROCK_ROUTER_MODEL=global.anthropic.claude-sonnet-5
BEDROCK_REPORTING_MODEL=global.anthropic.claude-sonnet-5
BEDROCK_CHAT_MODEL=global.anthropic.claude-opus-4-8
BEDROCK_EMBEDDING_MODEL=us.cohere.embed-v4:0
BEDROCK_RERANK_MODEL=cohere.rerank-v3-5:0

# Optional live connector credentials. Leave unset for local builder labs.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
ATLASSIAN_BASE_URL=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=
