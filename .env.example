# Aurora PostgreSQL connection string. Set this in your local .env file.
DATABASE_URL=

AWS_REGION=us-east-1
APP_DISPLAY_NAME=Evidence Trail

# Embeddings: hash is deterministic, local, and workshop-safe. bedrock is optional.
EMBED_PROVIDER=hash
EMBED_DIM=1024
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_RERANK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Optional live connector credentials. Leave unset for security review and default labs.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
ATLASSIAN_BASE_URL=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=
