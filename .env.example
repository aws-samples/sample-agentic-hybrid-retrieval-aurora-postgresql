# Aurora PostgreSQL connection string. Workshop Studio writes this at bootstrap.
DATABASE_URL=postgresql://workshop_admin:password@example.cluster.us-east-1.rds.amazonaws.com:5432/workshop_db

AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
APP_DISPLAY_NAME=AuraLens
PGVECTOR_VERSION=v0.8.2
PGVECTOR_MIN_VERSION=0.8.1
POSTGRES_MIN_VERSION=18.3

# Embeddings. Default is `bedrock` (real Cohere embed-v4): Workshop Studio
# restores the shipped seed dump, whose 1024-d vectors are real Cohere embeddings,
# so live /v1/search queries MUST embed with the same model to share that vector
# space. Requires AWS credentials with Bedrock access (the same ones used to build
# the dump). Set EMBED_PROVIDER=hash only for a fully offline, no-Bedrock corpus -
# but then you must also re-embed the data with the hash provider, or vector search
# will compare mismatched spaces.
EMBED_PROVIDER=bedrock
EMBED_DIM=1024
BEDROCK_OPUS_MODEL=global.anthropic.claude-opus-4-8
BEDROCK_SONNET_MODEL=global.anthropic.claude-sonnet-5
# Model routing: Sonnet 5 handles planning/tool routing; Opus 4.8 is the
# configured synthesis model for live answer composition paths that need deeper
# reasoning. The optional Claude Code CLI harness also uses Sonnet 5.
BEDROCK_ROUTER_MODEL=global.anthropic.claude-sonnet-5
BEDROCK_REPORTING_MODEL=global.anthropic.claude-sonnet-5
BEDROCK_CHAT_MODEL=global.anthropic.claude-opus-4-8
BEDROCK_EMBEDDING_MODEL=us.cohere.embed-v4:0
CLAUDE_CODE_MODEL=global.anthropic.claude-sonnet-5

# Reranking. Cohere Rerank v3.5 is invoked through the Amazon Bedrock Agent
# Runtime rerank API after Aurora SQL fusion selects the candidate pool.
COHERE_RERANK_ENABLED=1
COHERE_RERANK_MODEL=cohere.rerank-v3-5:0
COHERE_RERANK_MAX_DOCUMENTS=30

# Base URL of the FastAPI retrieval service. Consumed by the optional MCP server
# so tool calls reach /v1/search and /v1/agent/answer.
RETRIEVAL_API_URL=http://localhost:8000

# Optional live connector credentials. Leave unset for local builder labs.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
ATLASSIAN_BASE_URL=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=
