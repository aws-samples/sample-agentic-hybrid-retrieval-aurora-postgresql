# Local Postgres connection string. Set this in your local .env file.
DATABASE_URL=postgresql://localhost:55432/retrieval?sslmode=disable

AWS_REGION=us-east-1
APP_DISPLAY_NAME=Evidence Trail
PGVECTOR_VERSION=v0.8.2
PGVECTOR_MIN_VERSION=0.8.2
POSTGRES_MIN_VERSION=18.4
POSTGRES_HOME=/usr/local/opt/postgresql@18

# Embeddings: hash is deterministic, local, and workshop-safe. bedrock is optional.
EMBED_PROVIDER=hash
EMBED_DIM=1024
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_RERANK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Optional live connector credentials. Leave unset for local builder labs.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
ATLASSIAN_BASE_URL=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=
