# Aurora PostgreSQL connection string. Workshop Studio writes this at bootstrap.
DATABASE_URL=postgresql://workshop_admin:password@example.cluster.us-east-1.rds.amazonaws.com:5432/workshop_db
# Bound failed network attempts so API workers remain responsive.
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Optional RLS and column-masking module (sql/11_roles_rls.sql, sql/12_masking.sql).
# The core workshop leaves this off: it uses DATABASE_URL and requires neither
# persona roles nor pg_columnmask. When enabled, the API connects as the
# fail-closed workshop_app login below and assumes one persona per request, so a
# forgotten SET LOCAL ROLE reads nothing rather than everything. Apply
# `make security-schema` before turning it on.
WORKBENCH_SECURITY_ENABLED=0
WORKSHOP_APP_DATABASE_URL=
# Terminal identity for the module's psql exercises. Same fail-closed shape.
# G-30 asserts what this specific login can and cannot do, so it BLOCKS rather than
# guessing when the value is absent: no other identity can stand in for it.
WORKSHOP_PARTICIPANT_DATABASE_URL=

# Target for the destructive contract suite. It must name a different database
# than DATABASE_URL: the suite TRUNCATEs every casework, retrieval, and proof
# table before each run. `make test` requires this value, an exact PostgreSQL
# 18.3 server, and a database name ending in '_test'.
TEST_DATABASE_URL=
ALLOW_TEST_DATABASE_RESET=0

AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
APP_DISPLAY_NAME="Hybrid Retrieval Workbench"

# Optional lock-analysis hand-off. Empty by default: the Proof surface still shows
# each run's observed execution window but no console deep-link button. Populate
# these from the dry run using a real console URL, with {region},
# {db_resource_id}, and optionally {window_start}/{window_end} placeholders.
# A button appears only when the template resolves.
WORKBENCH_DB_RESOURCE_ID=
WORKBENCH_REGION=
WORKBENCH_LOCK_URL_TEMPLATE=
PGVECTOR_VERSION=v0.8.2
PGVECTOR_MIN_VERSION=0.8.1
POSTGRES_MIN_VERSION=18.3

# Stored documents and live queries must use the same embedding model and input
# types. The workshop artifact uses Cohere Embed 4 through a US CRIS profile.
EMBED_PROVIDER=bedrock
EMBED_DIM=1024
BEDROCK_EMBEDDING_MODEL=us.cohere.embed-v4:0

# One configurable synthesis model, invoked through Bedrock Runtime Converse
# with Global CRIS. Mantle is not claimed while its Claude endpoint requires
# in-region model IDs.
BEDROCK_SYNTHESIS_MODEL=global.anthropic.claude-sonnet-5
BEDROCK_MODEL_TRANSPORT=converse_global_cris
BEDROCK_SYNTHESIS_MAX_TOKENS=1200
BEDROCK_MAX_ATTEMPTS=5

# Reranking. Cohere Rerank v3.5 is invoked through the Amazon Bedrock Agent
# Runtime rerank API after Aurora SQL fusion selects the candidate pool.
COHERE_RERANK_ENABLED=1
COHERE_RERANK_MODEL=cohere.rerank-v3-5:0
COHERE_RERANK_MAX_DOCUMENTS=30

# Base URL of the FastAPI retrieval service. Consumed by the optional MCP server
# so tool calls reach /v1/search and /v1/agent/answer.
RETRIEVAL_API_URL=http://localhost:8000

# Workshop Studio writes these when it provisions the managed MCP boundary.
# Leave blank for local API/UI development.
AGENTCORE_GATEWAY_ID=
AGENTCORE_GATEWAY_URL=
AGENTCORE_GATEWAY_TARGET_ID=
AGENTCORE_GATEWAY_AUTH=AWS_IAM
