DATABASE_URL=postgresql://mosaic_user:change_me@your-aurora-endpoint:5432/mosaic
EMBEDDING_DIM=1024
EMBEDDING_PROVIDER=bedrock
# service/config.py:218 and :224 read these two names. EMBEDDING_MODEL_ID and
# RERANK_MODEL_ID are read by nothing, so setting them silently leaves the
# defaults in place.
BEDROCK_EMBED_MODEL_ID=choose-at-deployment
RERANK_PROVIDER=bedrock
BEDROCK_RERANK_MODEL_ID=choose-at-deployment
