# Aurora only. There is no local database — see ARTIFACTS.md, which also covers
# connecting from a corporate network (sslnegotiation=direct) and the security
# group. Single-quote the value if it contains `&`, or sourcing this file fails.
DATABASE_URL='postgresql://USER:PASSWORD@YOUR-CLUSTER.cluster-xxxx.us-east-1.rds.amazonaws.com:5432/mosaic_catalog?sslmode=require'
EMBEDDING_PROVIDER=bedrock
BEDROCK_REGION=us-east-1
BEDROCK_EMBED_MODEL_ID=us.cohere.embed-v4:0
BEDROCK_RERANK_MODEL_ID=cohere.rerank-v3-5:0
BEDROCK_CHAT_MODEL_ID=global.anthropic.claude-sonnet-5
# Optional split route. Omit both to use BEDROCK_CHAT_MODEL_ID for the complete
# agent path. Set both only after the live model-route rehearsal passes.
# BEDROCK_AGENT_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_SYNTHESIS_MODEL_ID=global.anthropic.claude-sonnet-5
RERANK_REQUIRED=true
CATALOG_MANIFEST_PATH=data/full/manifest.json

# Retrieval numbers live in db/config/retrieval.yaml, which is their single
# source. VECTOR_DIM, RRF_K, BUSINESS_WEIGHT, FTS_CANDIDATE_LIMIT,
# TRIGRAM_CANDIDATE_LIMIT, SEMANTIC_CANDIDATE_LIMIT, RERANK_CANDIDATE_LIMIT and
# HNSW_EF_SEARCH still override the yaml if you set them, but they are
# deliberately not listed with values here: copying a value into this file makes
# it a second copy that drifts. Edit the yaml instead.
#
# This file previously shipped BUSINESS_WEIGHT=0.15 against a le=0.05 bound, and
# every search returned an unhandled HTTP 500. See docs/rewrite-losses.md LOSS-3.
