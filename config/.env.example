# Aurora only. There is no local database — see ARTIFACTS.md for the security
# group and connection requirements. Single-quote the value if it contains `&`,
# or sourcing this file fails.
DATABASE_URL='postgresql://USER:PASSWORD@YOUR-CLUSTER.cluster-xxxx.us-east-1.rds.amazonaws.com:5432/mosaic_catalog?sslmode=require'
# Managed-host alternative: unset DATABASE_URL and set the ARN of a secret
# containing the DSN as text or {"DATABASE_URL":"postgresql://..."}.
# MOSAIC_DATABASE_SECRET_ARN=arn:aws:secretsmanager:REGION:ACCOUNT:secret:NAME
MOSAIC_SOURCE_REVISION=
# Select the verified real-product restore, shared by Shop and required labs.
MOSAIC_CATALOG_DATASET=reviews-2023-500k-v1
# The live writer instance class, for example db.r8g.2xlarge. Recorded on
# every measured artifact; `make score-evals` and `make ablation-evals` refuse
# to run without it.
AURORA_INSTANCE_CLASS=
EMBEDDING_PROVIDER=bedrock
BEDROCK_REGION=us-east-1
BEDROCK_EMBED_MODEL_ID=us.cohere.embed-v4:0
BEDROCK_RERANK_MODEL_ID=cohere.rerank-v3-5:0
BEDROCK_CHAT_MODEL_ID=global.anthropic.claude-sonnet-5
# Optional split route. Omit both to use BEDROCK_CHAT_MODEL_ID for the complete
# agent path. Set both only after the live model-route rehearsal passes.
# BEDROCK_AGENT_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_SYNTHESIS_MODEL_ID=global.anthropic.claude-sonnet-5
RERANK_REQUIRED=true

# Deployment identity and service behavior. These are not retrieval-tuning
# values, so their defaults belong here rather than in retrieval.yaml.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RERANK_PROVIDER=bedrock
# Development hash vectors never support workshop relevance claims. Keep false
# for every attendee and presenter environment.
ALLOW_DEVELOPMENT_EMBEDDINGS=false

# Where the storefront's Code Editor link points. The Workshop Studio bootstrap
# discovers the editor's CloudFront domain and writes this line into the
# generated .env; leave it empty anywhere else and the link is hidden. Use the
# tokenless form only, https://EDITOR-DOMAIN/?folder=/home/USER/sample-agentic-
# hybrid-retrieval-aurora-postgresql. The tkn= token in the CodeEditorURL stack
# output is a credential, this value reaches every browser that loads the page,
# and the service refuses to start if it finds one here.
MOSAIC_CODE_EDITOR_URL=

# Optional OpenTelemetry projection. Aurora remains the canonical evidence
# ledger. Leave both false for Workshop Studio; installing and configuring an
# exporter is an operator-owned deployment choice.
MOSAIC_AGENTCORE_OBSERVABILITY=false
MOSAIC_AGENTCORE_CAPTURE_CONTENT=false

# Optional Session & Memory tab. A dedicated AgentCore Memory resource stores
# conversation events and extracted memories. Aurora owns retrieval history.
MOSAIC_AGENTCORE_MEMORY_ID=

# Caller trust boundary. The API's only caller identity is a shared secret;
# it authorizes protected work, it is not a participant identity, and this
# deployment has no per-user accounting. In the deployed workshop, nginx on
# the Code Editor host forwards this value as X-Mosaic-Origin-Verify for every
# request that actually came through CloudFront's configured origin (see
# deploy/mosaic-bootstrap.sh), and the API verifies it independently so a
# direct call to the backend port -- bypassing nginx -- or a spoofed header
# performs no protected work. `/api/health` is the one unauthenticated route.
#
# Required=true with no secret set refuses to start (fail closed) rather than
# serving every caller; deploy/mosaic-bootstrap.sh always sets both of the
# next two lines and never sets the bypass below.
MOSAIC_REQUIRE_ORIGIN_VERIFICATION=true
MOSAIC_ORIGIN_VERIFY_SECRET=
# Explicit, loopback-only development bypass: set to false ONLY to run the API
# locally with `uvicorn service.main:app` and call it from the same machine,
# with no nginx in front of it. Even then it serves only requests whose peer
# address is the API process's own loopback interface (127.0.0.1 / ::1); a
# remote caller is refused regardless of this setting. Never set this in a
# reachable deployment -- deploy/mosaic-bootstrap.sh never sets it, and it is
# not documented as an override any make target applies.
# MOSAIC_REQUIRE_ORIGIN_VERIFICATION=false

# Admission control for model-backed and expensive-diagnostic routes
# (/api/search, /api/agent/answer(/stream), /api/retrieval/fusion-comparison,
# product evidence, retrieval-plan capture, the HNSW probe, and lab proof).
# Both counters are this one process's own -- see service/access_control.py
# for what that does and does not bound across multiple processes or
# instances. Sized against DB_POOL_MAX_SIZE=16 and for a full workshop room;
# see service/config.py for the exact rationale behind each default.
MOSAIC_MAX_CONCURRENT_MODEL_RUNS=12
MOSAIC_MODEL_RATE_LIMIT_PER_MINUTE=120

# Transaction-local database deadlines, `SET LOCAL` at every pooled connection
# checkout so a reused connection never inherits a previous request's values.
# 30s covers every single-statement duration measured elsewhere in this
# repository with roughly 10x headroom; 5s lock_timeout fails fast on this
# read-mostly service's few write paths.
MOSAIC_DB_STATEMENT_TIMEOUT_MS=30000
MOSAIC_DB_LOCK_TIMEOUT_MS=5000

# Overall wall-clock budget for one agent turn's model-and-tool loop, wrapping
# however many Bedrock calls and provider retries it makes so the total cannot
# exceed this regardless of per-call retry backoff.
MOSAIC_AGENT_TURN_DEADLINE_SECONDS=90

# Retrieval numbers live in db/config/retrieval.yaml, which is their single
# source. VECTOR_DIM, RRF_K, BUSINESS_WEIGHT, FTS_CANDIDATE_LIMIT,
# TRIGRAM_CANDIDATE_LIMIT, SEMANTIC_CANDIDATE_LIMIT, RERANK_CANDIDATE_LIMIT and
# HNSW_EF_SEARCH still override the yaml if you set them, but they are
# deliberately not listed with values here: copying a value into this file makes
# it a second copy that drifts. Edit the yaml instead.
#
# This file previously shipped BUSINESS_WEIGHT=0.15 against a le=0.05 bound, and
# every search returned an unhandled HTTP 500. See docs/rewrite-losses.md LOSS-3.
