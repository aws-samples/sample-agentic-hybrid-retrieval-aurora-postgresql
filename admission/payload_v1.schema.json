{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbench.workshop/admission/payload_v1.schema.json",
  "title": "admission payload v1",
  "type": "object",
  "required": ["schema", "source", "kind", "external_key", "title", "occurred_at", "body", "structured"],
  "properties": {
    "schema": {"const": "admission payload v1"},
    "source": {
      "type": "object",
      "required": ["system", "uri"],
      "properties": {
        "system": {"type": "string"},
        "uri": {"type": "string"},
        "observation_window": {
          "type": "object",
          "properties": {"start": {"type": "string"}, "end": {"type": ["string", "null"]}}
        }
      }
    },
    "kind": {"const": "lock_evidence"},
    "external_key": {"type": "string"},
    "title": {"type": "string"},
    "occurred_at": {"type": "string"},
    "available_at": {"type": ["string", "null"]},
    "acl": {"type": "object"},
    "body": {"type": "string"},
    "structured": {
      "type": "object",
      "required": ["incident_external_key", "captured_at", "relation_name",
                   "blocked_pid", "blocking_pid", "wait_event_type", "wait_event",
                   "blocked_statement", "blocking_statement"],
      "properties": {
        "incident_external_key": {"type": "string"},
        "change_external_key": {"type": "string"},
        "captured_at": {"type": "string"},
        "relation_name": {"type": "string"},
        "relation_oid": {"type": "integer"},
        "wait_event_type": {"const": "Lock"},
        "wait_event": {"const": "relation"},
        "blocked_pid": {"type": "integer"},
        "blocking_pid": {"type": "integer"},
        "blocked_state": {"type": "string"},
        "blocked_query_start": {"type": "string"},
        "blocked_lock_mode": {"type": "string"},
        "blocked_lock_granted": {"type": "boolean"},
        "blocking_lock_mode": {"type": "string"},
        "blocking_lock_granted": {"type": "boolean"},
        "blocking_pids": {
          "type": "array",
          "items": {"type": "integer"}
        },
        "blocking_pids_sql": {"type": "string"},
        "blocking_pids_output": {"type": "string"},
        "blocked_statement": {"type": "string"},
        "blocking_statement": {"type": "string"},
        "raw_capture": {"type": "object"}
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["to_external_key", "to_kind", "relation"],
        "properties": {
          "to_external_key": {"type": "string"}, "to_kind": {"type": "string"},
          "relation": {"type": "string"}, "confidence": {"type": "number"}
        }
      }
    }
  }
}
