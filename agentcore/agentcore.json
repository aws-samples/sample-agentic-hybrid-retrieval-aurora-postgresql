{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "HybridRetrieval",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "HybridRetrieval",
    "project": "sample-agentic-hybrid-retrieval-aurora-postgresql"
  },
  "runtimes": [],
  "memories": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "hybrid-retrieval-gateway",
      "description": "Exposes full_text_search, vector_search, fuzzy_match, and hybrid_search over the ops schema as MCP tools.",
      "targets": [
        {
          "name": "retrieval",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "${GATEWAY_LAMBDA_ARN}",
            "toolSchemaFile": "gateway/retrieval_tools.json"
          }
        }
      ],
      "authorizerType": "NONE",
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "httpGateways": [],
  "harnesses": [],
  "datasets": []
}
